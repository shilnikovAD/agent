# ключ OpenRouter: только вызов моделей, лимит трат на ключе ставится в настройках OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Telegram-бот (необязательно: без токена `docker compose up` запускает демо на сохранённом чате)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# OWNER_TELEGRAM_ID=123456789      # ваш числовой id: только вы подтверждаете черновики
# OWNER_USERNAME=artur_sh          # ваш username: по нему агент понимает, что сообщение вам

# потолки денег (USD): на одно входящее сообщение и на день
# MAX_USD_PER_TASK=0.03
# MAX_USD_PER_DAY=2.0

# для домашних заданий: адрес Milvus для hw4 (сервер или файл Milvus Lite)
# HW4_MILVUS_URI=./milvus_hw4.db
